{
  "manifest_version": 2,
  "name": "Unveil",
  "version": "0.2.0",
  "description": "Hides paywall overlays, restores scrolling and clipped article text, and blocks known paywall vendor scripts.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{f9e4d419-f4df-435f-bc23-2466c032e5d1}",
      "update_url": "https://raw.githubusercontent.com/Kelevrust/Unveil/main/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/unveil.svg",
    "96": "icons/unveil.svg"
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["compat.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Unveil",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/unveil.svg"
  }
}
